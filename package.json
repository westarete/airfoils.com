{
  "name": "airfoils.com",
  "version": "1.0.0",
  "description": "Static website for Airfoils, the aerodynamic consulting firm of Dan Somers.",
  "main": "index.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/style.css --minify",
    "build:11ty": "npx eleventy",
    "build": "npm run build:css && npm run build:11ty",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/style.css --watch",
    "dev:11ty": "npx eleventy --serve",
    "dev": "npm run build:css && npm-run-all --parallel dev:*",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/westarete/airfoils.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/westarete/airfoils.com/issues"
  },
  "homepage": "https://github.com/westarete/airfoils.com#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/cli": "^4.1.18",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.18"
  }
}
