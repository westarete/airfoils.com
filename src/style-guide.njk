{# ============================================ #}
{# Accessibility #}
{# ============================================ #}

<section class="mb-16">
  <h2 class="text-2xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-300">Accessibility</h2>

  <p class="text-gray-700 mb-4">
    Target: <strong>WCAG 2.1 Level AA</strong>
  </p>

  <ul class="list-disc list-inside text-gray-700 space-y-1">
    <li>Color contrast ≥ 4.5:1 for normal text, ≥ 3:1 for large text</li>
    <li>All images have alt text</li>
    <li>Heading hierarchy is logical (h1 → h2 → h3, no skips)</li>
    <li>Interactive elements are keyboard accessible</li>
    <li>Focus states are visible</li>
    <li>Skip link to main content</li>
    <li>No reliance on color alone to convey information</li>
  </ul>
</section>

