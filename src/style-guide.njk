{# ============================================ #}
{# Typography #}
{# ============================================ #}

<section class="mb-16">
  <h2 class="text-2xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-300">Typography</h2>

  <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 mb-6">
    <p class="text-gray-700 mb-2">
      <strong>Rationale:</strong> We use system fonts for performance and native feel.
      The legacy site used Arial/Helvetica, so this maintains continuity while
      looking better on each platform.
    </p>
    <p class="text-sm text-gray-600 mb-2">
      <strong>Font stack:</strong>
      <code class="bg-gray-200 px-1 rounded text-xs">ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif</code>
    </p>
    <p class="text-sm text-gray-600">
      <strong>Type scale:</strong> Based on Tailwind defaults (roughly 1.25 ratio / Major Third).
    </p>
  </div>

  <div class="space-y-6">
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">5xl / Hero</span>
      <p class="text-5xl font-bold text-primary-700">Only The Best Is Good Enough</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">4xl / H1</span>
      <p class="text-4xl font-bold text-gray-900">Page Title</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">3xl / H2</span>
      <p class="text-3xl font-semibold text-gray-800">Section Heading</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">2xl / H3</span>
      <p class="text-2xl font-semibold text-gray-800">Subsection Heading</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">xl / H4</span>
      <p class="text-xl font-medium text-gray-700">Card Title</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">lg / Lead</span>
      <p class="text-lg text-gray-600">Lead paragraph text for introductions and summaries.</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">base / Body</span>
      <p class="text-base text-gray-700">Regular body text. Airfoils, Incorporated is a consulting firm specializing in airfoil design, analysis, and testing, including high-lift systems.</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">sm / Secondary</span>
      <p class="text-sm text-gray-600">Secondary text for captions and metadata.</p>
    </div>
    <div>
      <span class="text-xs text-gray-500 uppercase tracking-wide">xs / Fine print</span>
      <p class="text-xs text-gray-500">Fine print and legal text.</p>
